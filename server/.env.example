PORT=5001
MONGODB_URI=mongodb://localhost:27017/visions-learn
JWT_SECRET=replace-with-a-long-random-string

# AI Educator Assistant — defaults to the offline "stub" provider (no key
# needed). Set AI_PROVIDER=openai + OPENAI_API_KEY once the team picks a
# real provider; no code changes required.
AI_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
